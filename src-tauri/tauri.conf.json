{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WhatsIP",
  "version": "0.1.0",
  "identifier": "com.whatsip.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "label": "main", "title": "WhatsIP", "width": 1100, "height": 760, "minWidth": 720, "minHeight": 540 }],
    "security": { "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost data:; frame-src https://www.openstreetmap.org" }
  },
  "bundle": { "active": false, "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"] }
}
